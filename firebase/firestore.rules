    function blocked4(t) { return t.matches("(?s).*(^|[^a-z0-9])(chi[^a-z0-9]+chi[^a-z0-9]+man|china[^a-z0-9]+swede|china[^a-z0-9]+swedes|ching[^a-z0-9]+chong|ching[^a-z0-9]+chongs|christ[^a-z0-9]+killer|christ[^a-z0-9]+killers|coon[^a-z0-9]+ass|coon[^a-z0-9]+asses|curry[^a-z0-9]+muncher|curry[^a-z0-9]+munchers|diaper[^a-z0-9]+head|diaper[^a-z0-9]+heads|dot[^a-z0-9]+head|dot[^a-z0-9]+heads|dune[^a-z0-9]+coon|dune[^a-z0-9]+coons|eight[^a-z0-9]+ball|eight[^a-z0-9]+balls|fudge[^a-z0-9]+packer|gator[^a-z0-9]+bait|gook[^a-z0-9]+eye|gook[^a-z0-9]+eyes|half[^a-z0-9]+breed|half[^a-z0-9]+caste|jungle[^a-z0-9]+bunnies|jungle[^a-z0-9]+bunny|kwai[^a-z0-9]+lo|kwai[^a-z0-9]+los|mau[^a-z0-9]+mau|mau[^a-z0-9]+maus|moon[^a-z0-9]+cricket|moon[^a-z0-9]+crickets|pancake[^a-z0-9]+face|pancake[^a-z0-9]+faces|pillow[^a-z0-9]+biter|pommie[^a-z0-9]+grant|pommie[^a-z0-9]+grants|porch[^a-z0-9]+monkey|porch[^a-z0-9]+monkies|prairie[^a-z0-9]+nigger|prairie[^a-z0-9]+niggers|round[^a-z0-9]+eyes|sand[^a-z0-9]+nigger|sand[^a-z0-9]+niggers|swamp[^a-z0-9]+guinea|swamp[^a-z0-9]+guineas|tar[^a-z0-9]+babies|tar[^a-z0-9]+baby|timber[^a-z0-9]+nigger|timber[^a-z0-9]+niggers|towel[^a-z0-9]+head|towel[^a-z0-9]+heads|uncle[^a-z0-9]+tom|white[^a-z0-9]+trash)([^a-z0-9]|$).*"); }
    function blocked(t) { return blocked0(plain(t)) || blocked1(plain(t)) || blocked2(plain(t)) || blocked3(plain(t)) || blocked4(plain(t)); }
    function links(t) { return t.matches("(?is).*(https?://|www[.]).*"); }
    function tooManyLinks(t) { return t.matches("(?is).*(https?://|www[.]).*(https?://|www[.]).*(https?://|www[.]).*"); }
    function okName(n) { return n is string && n.size() >= 1 && n.size() <= 40 && n.trim() == n && !links(n) && !blocked(n); }
    function okBody(b) { return b is string && b.size() >= 1 && b.size() <= 2000 && !tooManyLinks(b) && !blocked(b); }
    function okId(s) { return s is string && s.matches("[a-z0-9-]{1,40}"); }

